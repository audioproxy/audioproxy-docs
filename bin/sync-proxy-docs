#!/usr/bin/env ruby
# Syncs the API contract from the audioproxy repo. ONLY the contract: it must
# be exact, so it stays 1:1 with upstream. Every other page on this site is
# AUTHORED here (user-facing, goal-first, no code internals) and may diverge
# from the repo docs by design; .github/workflows/sync.yml opens a drift
# issue when their upstream counterparts change.
# Usage: bin/sync-proxy-docs [path-to-audioproxy-checkout]

require "fileutils"

SRC = File.expand_path(ARGV[0] || "../audioproxy", __dir__ + "/..")
DST = File.expand_path("../src/content/docs", __dir__)

sha = `git -C #{SRC} rev-parse --short HEAD`.strip
abort "cannot resolve #{SRC}" if sha.empty?

path = File.join(SRC, "docs", "audio-proxy-api-v1.md")
body = File.read(path)
title = body[/^#\s+(.+)$/, 1] or abort "no H1"
body = body.sub(/^#\s+.+\n+/, "")
body = body.gsub(/\((\.\.\/[^)\s]+)\)/) { "(https://github.com/audioproxy/audioproxy/blob/main/#{$1.sub("../", "")})" }

out  = "---\ntitle: \"#{title.gsub('"', '\"')}\"\n"
out << "description: \"The v1 contract: URL grammar, processing options, cache-key rules, response semantics, and error codes.\"\n---\n\n"
out << "<!-- synced 1:1 from audioproxy@#{sha} docs/audio-proxy-api-v1.md; the contract is canonical there -->\n\n"
out << body
FileUtils.mkdir_p(File.join(DST, "reference"))
File.write(File.join(DST, "reference/api-v1.md"), out)
File.write(File.expand_path("../.synced-sha", __dir__), sha + "\n")
puts "synced api-v1 @#{sha}"
