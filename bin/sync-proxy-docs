#!/usr/bin/env ruby
# Syncs operator docs from the audioproxy repo into this site.
# The proxy repo is CANONICAL for these files (its slices update them in the
# same change, per its conventions); edit them THERE, then re-run this.
# Usage: bin/sync-proxy-docs [path-to-audioproxy-checkout]

require "fileutils"

SRC = File.expand_path(ARGV[0] || "../audioproxy", __dir__ + "/..")
DST = File.expand_path("../src/content/docs", __dir__)

# destination and a curated description per page (rendered in search results
# and link previews; the H1-derived title alone says too little there)
MAP = {
  "sources.md"            => ["guides/sources.md",          "Source forms and encodings (local://, s3://, https://), the allowlist grammar, and what the proxy refuses."],
  "scaling.md"            => ["guides/scaling.md",          "Multi-node deployment: load balancing, readiness, Kubernetes and Fly.io wiring, and what stays per-node."],
  "capacity.md"           => ["guides/capacity.md",         "Worst-case memory as arithmetic: the model, a measured per-format table, and a sizing matrix."],
  "s3-providers.md"       => ["guides/s3-providers.md",     "Working configurations for AWS, MinIO, Cloudflare R2, Tigris and other S3-compatible stores."],
  "rendering.md"          => ["guides/rendering.md",        "How a render runs: the ffmpeg subprocess, chunk streaming, coalescing, slots, timeouts, and kill guarantees."],
  "ffmpeg-arguments.md"   => ["guides/ffmpeg-arguments.md", "How processing options become ffmpeg arguments: filter order, per-format flags, and measured trade-offs."],
  "development.md"        => ["guides/development.md",      "Toolchain, per-slice worktrees, the test suite and its tags, CI jobs, and how a release is cut."],
  "audio-proxy-api-v1.md" => ["reference/api-v1.md",        "The v1 contract: URL grammar, processing options, cache-key rules, response semantics, and error codes."],
}

SLUG = MAP.to_h { |src, (dst, _)| [src, "/" + dst.sub(/\.md\z/, "/")] }

sha = `git -C #{SRC} rev-parse --short HEAD`.strip
abort "cannot resolve #{SRC}" if sha.empty?

MAP.each do |src_name, (dst_rel, description)|
  path = File.join(SRC, "docs", src_name)
  abort "missing #{path}" unless File.exist?(path)
  body = File.read(path)

  title = body[/^#\s+(.+)$/, 1] or abort "no H1 in #{src_name}"
  body = body.sub(/^#\s+.+\n+/, "")

  body = body.gsub(/\(([\w.-]+\.md)(#[^)\s]*)?\)/) do
    name, anchor = $1, $2
    SLUG[name] ? "(#{SLUG[name]}#{anchor})" : "(https://github.com/audioproxy/audioproxy/blob/main/docs/#{name}#{anchor})"
  end
  body = body.gsub(/\((\.\.\/[^)\s]+)\)/) do
    "(https://github.com/audioproxy/audioproxy/blob/main/#{$1.sub("../", "")})"
  end

  out = +"---\n"
  out << "title: \"#{title.gsub('"', '\"')}\"\n"
  out << "description: \"#{description}\"\n"
  out << "---\n\n"
  out << "<!-- synced from audioproxy@#{sha} docs/#{src_name}; canonical there. Edit in the proxy repo, then run bin/sync-proxy-docs -->\n\n"
  out << body

  dst = File.join(DST, dst_rel)
  FileUtils.mkdir_p(File.dirname(dst))
  File.write(dst, out)
  puts "synced #{src_name} -> #{dst_rel} (@#{sha})"
end
