#!/usr/bin/env ruby
# Syncs operator docs from the audioproxy repo into this site.
# The proxy repo is CANONICAL for these files (its slices update them in the
# same change, per its conventions); edit them THERE, then re-run this.
# Usage: bin/sync-proxy-docs [path-to-audioproxy-checkout]

require "fileutils"

SRC = File.expand_path(ARGV[0] || "../audioproxy", __dir__ + "/..")
DST = File.expand_path("../src/content/docs", __dir__)

MAP = {
  "sources.md"            => "guides/sources.md",
  "scaling.md"            => "guides/scaling.md",
  "capacity.md"           => "guides/capacity.md",
  "s3-providers.md"       => "guides/s3-providers.md",
  "rendering.md"          => "guides/rendering.md",
  "ffmpeg-arguments.md"   => "guides/ffmpeg-arguments.md",
  "development.md"        => "guides/development.md",
  "audio-proxy-api-v1.md" => "reference/api-v1.md",
}

# target slug for rewritten intra-doc links
SLUG = MAP.to_h { |src, dst| [src, "/" + dst.sub(/\.md\z/, "/")] }

sha = `git -C #{SRC} rev-parse --short HEAD`.strip
abort "cannot resolve #{SRC}" if sha.empty?

MAP.each do |src_name, dst_rel|
  path = File.join(SRC, "docs", src_name)
  abort "missing #{path}" unless File.exist?(path)
  body = File.read(path)

  # title from the first H1; strip it (Starlight renders the frontmatter title)
  title = body[/^#\s+(.+)$/, 1] or abort "no H1 in #{src_name}"
  body = body.sub(/^#\s+.+\n+/, "")

  # intra-doc links -> site slugs (with optional #anchor)
  body = body.gsub(/\(([\w.-]+\.md)(#[^)\s]*)?\)/) do
    name, anchor = $1, $2
    SLUG[name] ? "(#{SLUG[name]}#{anchor})" : "(https://github.com/audioproxy/audioproxy/blob/main/docs/#{name}#{anchor})"
  end
  # repo-relative links (../bin/foo, ../README.md ...) -> GitHub
  body = body.gsub(/\((\.\.\/[^)\s]+)\)/) do
    "(https://github.com/audioproxy/audioproxy/blob/main/#{$1.sub("../", "")})"
  end

  out = +"---\n"
  out << "title: \"#{title.gsub('"', '\"')}\"\n"
  out << "---\n\n"
  out << ":::note\nSynced from [`audioproxy@#{sha}`](https://github.com/audioproxy/audioproxy/blob/#{sha}/docs/#{src_name}) — that repo is canonical; edit there, then re-run `bin/sync-proxy-docs`.\n:::\n\n"
  out << body

  dst = File.join(DST, dst_rel)
  FileUtils.mkdir_p(File.dirname(dst))
  File.write(dst, out)
  puts "synced #{src_name} -> #{dst_rel}"
end
