---
// The landing page's animated signature: two channels sweep in, overprint,
// and resolve into one rendered variant. Ported from the Claude Design
// landing export; colors ride the brand tokens so both themes work.
---

<div class="ap-stereo" aria-hidden="true">
  <svg viewBox="0 0 1200 190" preserveAspectRatio="none">
    <g class="ap-ch-l">
      <polyline
        points="0,95 60,95 96,38 132,150 168,52 204,140 240,60 276,132 312,70 348,124 384,78 420,116 456,86 492,108 528,92 564,100 600,95 660,95"
        fill="none" stroke="var(--ap-ch-l)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></polyline>
    </g>
    <g class="ap-ch-r">
      <polyline
        points="0,95 48,95 84,148 120,42 156,138 192,54 228,128 264,66 300,120 336,74 372,112 408,82 444,106 480,88 516,102 552,94 600,95 660,95"
        fill="none" stroke="var(--ap-ch-r)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></polyline>
    </g>
    <polyline class="ap-variant"
      points="600,95 648,80 696,110 744,84 792,106 840,88 888,102 936,90 984,100 1032,93 1080,97 1200,95"
      fill="none" stroke="var(--ap-mix)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"
      stroke-dasharray="620"></polyline>
    <g class="ap-sweep"><rect x="0" y="0" width="2" height="190" fill="var(--sl-color-white)"></rect></g>
  </svg>
  <div class="ap-label ap-label-l">L &times; R</div>
  <div class="ap-label ap-label-r">rendered variant</div>
</div>

<style>
  .ap-stereo {
    position: relative;
    height: 190px;
    border-top: 1px solid var(--sl-color-hairline);
    border-bottom: 1px solid var(--sl-color-hairline);
    overflow: hidden;
    margin: 2.5rem 0 0.5rem;
  }
  .ap-stereo svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ap-ch-l { animation: ap-phase-l 6.5s ease-in-out infinite, ap-fade-out 5s linear infinite; }
  .ap-ch-r { animation: ap-phase-r 6.5s ease-in-out infinite, ap-fade-out 5s linear infinite; }
  .ap-variant { animation: ap-draw 5s linear infinite; }
  .ap-sweep { animation: ap-sweep 5s linear infinite; }
  .ap-label {
    position: absolute;
    bottom: 10px;
    font-family: var(--sl-font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .ap-label-l { left: 0; }
  .ap-label-r { right: 0; color: var(--ap-mix); }

  @keyframes ap-sweep {
    0% { transform: translateX(-20px); opacity: 0; }
    8% { opacity: 1; }
    88% { opacity: 1; }
    100% { transform: translateX(1180px); opacity: 0; }
  }
  @keyframes ap-draw {
    0%, 8% { stroke-dashoffset: 620; }
    72%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes ap-phase-l {
    0%, 100% { transform: translateY(-7px); }
    50% { transform: translateY(3px); }
  }
  @keyframes ap-phase-r {
    0%, 100% { transform: translateY(7px); }
    50% { transform: translateY(-3px); }
  }
  @keyframes ap-fade-out {
    0%, 40% { opacity: 0.95; }
    88%, 100% { opacity: 0.16; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ap-ch-l, .ap-ch-r, .ap-variant, .ap-sweep { animation: none; }
    .ap-sweep { display: none; }
  }
</style>
